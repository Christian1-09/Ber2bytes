<Window x:Class="Ber2Bytes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:components="clr-namespace:Ber2Bytes.Components"
        Title="Ber2Bytes — Automated Inventory and Sales Tracking System"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#0B0B0C">
    <Grid>
        <blazor:BlazorWebView x:Name="WebView"
                              HostPage="wwwroot\index.html"
                              StartPath="/login"
                              Services="{DynamicResource services}"
                              BlazorWebViewInitialized="OnWebViewInitialized">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
